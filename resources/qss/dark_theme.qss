/* Dark Red and Black Theme for Yalda Gym Application */

QWidget {
    background-color: #121212;
    color: #FFFFFF;
    font-family: "Vazirmatn", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #121212;
}

/* Header Bar & Frames */
QFrame#sidebar {
    background-color: #181818;
    border-left: 1px solid #282828;
}

QFrame#card {
    background-color: #1E1E1E;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    padding: 12px;
}

/* Headings & Labels */
QLabel {
    background-color: transparent;
}

QLabel#h1 {
    font-size: 20px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel#h2 {
    font-size: 16px;
    font-weight: bold;
    color: #8B0000;
}

QLabel#accent_text {
    color: #A91D22;
    font-weight: bold;
}

QLabel#muted_text {
    color: #888888;
}

/* Buttons */
QPushButton {
    background-color: #8B0000;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #A91D22;
}

QPushButton:pressed {
    background-color: #660000;
}

QPushButton:disabled {
    background-color: #333333;
    color: #666666;
}

QPushButton#secondary_button {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: 1px solid #444444;
}

QPushButton#secondary_button:hover {
    background-color: #3D3D3D;
    color: #FFFFFF;
}

QPushButton#secondary_button:disabled {
    background-color: #2D2D2D;
    color: #777777;
    border: 1px solid #444444;
}

QPushButton#back_button {
    background-color: #262626;
    color: #E0E0E0;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#back_button:hover {
    background-color: #363636;
    color: #FFFFFF;
    border-color: #666666;
}

QPushButton#back_button:pressed {
    background-color: #1A1A1A;
}

QPushButton#undo_button, QPushButton#redo_button {
    background-color: #242424;
    color: #DDDDDD;
    border: 1px solid #3E3E3E;
    border-radius: 6px;
    padding: 5px 12px;
    font-weight: bold;
    font-size: 12px;
}

QPushButton#undo_button:hover, QPushButton#redo_button:hover {
    background-color: #333333;
    color: #FFFFFF;
    border-color: #555555;
}

QPushButton#undo_button:disabled, QPushButton#redo_button:disabled {
    background-color: #1A1A1A;
    color: #555555;
    border: 1px solid #2B2B2B;
}

QPushButton#danger_button {
    background-color: #D32F2F;
}

QPushButton#danger_button:hover {
    background-color: #B71C1C;
}

/* Inputs & ComboBox */
QLineEdit, QTextEdit, QPlainTextEdit, QDateEdit, QComboBox {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 6px 12px;
    selection-background-color: #8B0000;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #8B0000;
}

QComboBox {
    padding-left: 32px;
    padding-right: 12px;
}

QComboBox:editable {
    background-color: #1E1E1E;
    color: #FFFFFF;
}

QComboBox QLineEdit {
    background: transparent;
    color: #FFFFFF;
    border: none;
    padding: 0px 4px;
    selection-background-color: #8B0000;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    width: 28px;
    border-right: 1px solid #3A3A3A;
    background-color: #262626;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
}

QComboBox::down-arrow {
    image: url(resources/images/arrow_down.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #1E1E1E;
    color: #FFFFFF;
    selection-background-color: #8B0000;
    padding: 4px;
}

/* SpinBox & DoubleSpinBox Styling */
QSpinBox, QDoubleSpinBox {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 13px;
    font-weight: bold;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top left;
    width: 24px;
    border-right: 1px solid #3A3A3A;
    border-bottom: 1px solid #3A3A3A;
    background-color: #262626;
    border-top-left-radius: 5px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(resources/images/arrow_up.svg);
    width: 12px;
    height: 12px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom left;
    width: 24px;
    border-right: 1px solid #3A3A3A;
    background-color: #262626;
    border-bottom-left-radius: 5px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(resources/images/arrow_down.svg);
    width: 12px;
    height: 12px;
}

/* Tables */
QTableWidget {
    background-color: #141414;
    gridline-color: #282828;
    border: 1px solid #282828;
    border-radius: 6px;
    selection-background-color: #8B0000;
    selection-color: #FFFFFF;
    outline: 0;
}

QTableWidget::item {
    padding: 6px 8px;
    font-size: 13px;
}

QTableWidget::item:selected,
QTableWidget::item:alternate:selected {
    background-color: #4A1113;
}

QHeaderView::section {
    background-color: #222222;
    color: #FFFFFF;
    padding: 10px 6px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-bottom: 2px solid #8B0000;
}

/* Specific styling for inputs embedded inside QTableWidget */
QTableWidget QLineEdit {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 2px 4px;
    min-height: 32px;
    font-size: 13px;
}

QTableWidget QLineEdit:focus {
    border: 1px solid #E53935;
    background-color: #252525;
}

QTableWidget QComboBox {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 2px 4px;
    min-height: 32px;
    font-size: 13px;
}

QTableWidget QComboBox:focus {
    border: 1px solid #E53935;
}

QTableWidget QPushButton {
    min-height: 30px;
    padding: 2px 4px;
    font-size: 12px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #2A2A2A;
    background-color: #1E1E1E;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #121212;
    color: #AAAAAA;
    padding: 10px 20px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-left: 2px;
}

QTabBar::tab:selected {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border-top: 3px solid #8B0000;
    font-weight: bold;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #121212;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #333333;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #8B0000;
}

QScrollBar:horizontal {
    background: #121212;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #333333;
    border-radius: 5px;
}

/* Radio Buttons */
QRadioButton {
    color: #FFFFFF;
    spacing: 10px;
    font-size: 13px;
    background: transparent;
    padding: 3px 0px;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border: 2px solid #666666;
    background-color: #1A1A1A;
}

QRadioButton::indicator:hover {
    border: 2px solid #DC2626;
    background-color: #262626;
}

QRadioButton::indicator:checked {
    border: 2px solid #EF4444;
    background-color: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.45, fx: 0.5, fy: 0.5,
        stop: 0 #FFFFFF, stop: 0.45 #FFFFFF,
        stop: 0.46 #8B0000, stop: 1 #8B0000);
}

QRadioButton::indicator:checked:hover {
    border: 2px solid #FF5555;
    background-color: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.45, fx: 0.5, fy: 0.5,
        stop: 0 #FFFFFF, stop: 0.45 #FFFFFF,
        stop: 0.46 #A91D22, stop: 1 #A91D22);
}

QRadioButton::indicator:disabled {
    border: 2px solid #444444;
    background-color: #222222;
}

/* Checkboxes */
QCheckBox {
    color: #FFFFFF;
    spacing: 10px;
    font-size: 13px;
    background: transparent;
    padding: 3px 0px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #666666;
    background-color: #1A1A1A;
}

QCheckBox::indicator:hover {
    border: 2px solid #DC2626;
    background-color: #262626;
}

QCheckBox::indicator:checked {
    border: 2px solid #EF4444;
    background-color: #8B0000;
    image: url(resources/images/check.svg);
}

QCheckBox::indicator:checked:hover {
    border: 2px solid #FF5555;
    background-color: #A91D22;
}

QCheckBox::indicator:disabled {
    border: 2px solid #444444;
    background-color: #222222;
}
